// =============================================================================
// Nexus Market — Prisma schema (MongoDB)
//
// Conventions:
//  - IDs are ObjectId strings: `String @id @default(auto()) @map("_id") @db.ObjectId`
//  - Money is stored as INTEGER MINOR UNITS (e.g. paisa): 10_000_00 = Rs. 10,000.00
//    Never use floating point for financial values.
//  - Every model has createdAt / updatedAt.
//  - Indexes only exist where we actually look things up.
//
// Relations note (MongoDB):
//  - Prisma uses `relationMode = "prisma"` semantics: referential integrity is
//    enforced in the application layer, not the database. Always filter queries
//    by owner fields (userId / sellerId / shopId) to enforce isolation.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  SELLER
  CUSTOMER
}

enum SellerApplicationStatus {
  NOT_APPLIED
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ShopStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  DISABLED
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  COD
  ONLINE
  CARD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
}

enum CommissionScope {
  GLOBAL
  CATEGORY
  SELLER
  PRODUCT
}

enum CouponType {
  PERCENT
  FIXED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  CLOSED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  RETURN_APPROVED
  RETURN_REJECTED
  REFUND_PROCESSED
  PAYOUT_APPROVED
  PAYOUT_REJECTED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  NEW_REVIEW
  NEW_SELLER_APPLICATION
  NEW_PAYOUT_REQUEST
  NEW_RETURN_REQUEST
  PAYMENT_FAILED
  SYSTEM
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

enum TokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum BannerStatus {
  ACTIVE
  SCHEDULED
  DISABLED
}

// -----------------------------------------------------------------------------
// Identity & access
// -----------------------------------------------------------------------------

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  email          String   @unique
  name           String
  passwordHash   String
  role           Role     @default(CUSTOMER)
  phone          String?
  emailVerified  Boolean  @default(false)
  isActive       Boolean  @default(true)
  avatarUrl      String?
  lastLoginAt    DateTime?

  sellerProfile  SellerProfile?
  cart           Cart?
  addresses      Address[]
  orders         Order[]
  reviews        Review[]
  wishlist       Wishlist[]
  notifications  Notification[]
  tokens         AuthToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([createdAt])
}

model AuthToken {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  userId    String       @db.ObjectId
  user      User         @relation(fields: [userId], references: [id])
  tokenHash String       @unique
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Seller domain
// -----------------------------------------------------------------------------

model SellerProfile {
  id                String                  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String                  @unique @db.ObjectId
  user              User                    @relation(fields: [userId], references: [id])

  applicationStatus SellerApplicationStatus @default(NOT_APPLIED)
  applicationNote   String?
  reviewedAt        DateTime?
  reviewedById      String?                 @db.ObjectId

  businessName      String?
  businessType      String?
  cnic              String?
  // Optional per-seller commission override (basis points, 1000 = 10%).
  // null = inherit global/category commission rules.
  commissionBps     Int?

  // Aggregates maintained by services (not computed on every read).
  ratingSum         Int                     @default(0)
  ratingCount       Int                     @default(0)

  shops             Shop[]
  products          Product[]
  sellerOrders      SellerOrder[]
  payouts           Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationStatus])
}

model Shop {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  sellerId     String      @unique @db.ObjectId
  seller       SellerProfile @relation(fields: [sellerId], references: [id])

  name         String
  slug         String      @unique
  tagline      String?
  description  String?
  logoUrl      String?
  bannerUrl    String?
  contactEmail String?
  contactPhone String?
  status       ShopStatus  @default(PENDING)

  ratingSum    Int         @default(0)
  ratingCount  Int         @default(0)

  products     Product[]
  sellerOrders SellerOrder[]
  reviews      Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Catalog
// -----------------------------------------------------------------------------

model Category {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String     @unique
  imageUrl  String?
  parentId  String?    @db.ObjectId
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Category[] @relation("CategoryTree")
  position  Int        @default(0)
  isActive  Boolean    @default(true)

  // Denormalized SEO fields
  metaTitle       String?
  metaDescription String?

  products Product[]
  brands   Brand[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, position])
  @@index([isActive])
}

model Brand {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  slug       String    @unique
  logoUrl    String?
  categoryId String?   @db.ObjectId
  category   Category? @relation(fields: [categoryId], references: [id])
  isActive   Boolean   @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Product {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId

  name           String
  slug           String        @unique
  description    String
  shortDescription String?

  // Money — integer minor units (paisa)
  price          Int
  salePrice      Int?
  costPrice      Int?
  // Denormalized effective price (salePrice ?? price) so catalog filters
  // and sorts stay a simple indexed comparison. Maintained by product services.
  effectivePrice Int           @default(0)

  sku            String
  status         ProductStatus @default(DRAFT)

  sellerId       String        @db.ObjectId
  seller         SellerProfile @relation(fields: [sellerId], references: [id])
  shopId         String        @db.ObjectId
  shop           Shop          @relation(fields: [shopId], references: [id])

  categoryId     String?       @db.ObjectId
  category       Category?     @relation(fields: [categoryId], references: [id])
  brandId        String?       @db.ObjectId
  brand          Brand?        @relation(fields: [brandId], references: [id])

  images         ProductImage[]
  variants       ProductVariant[]
  inventory      Inventory?
  cartItems      CartItem[]
  wishlist       Wishlist[]
  reviews        Review[]

  // Aggregates
  ratingSum      Int           @default(0)
  ratingCount    Int           @default(0)
  // Average rating in HUNDREDTHS of a star (4.3★ → 430) so min-rating
  // filters stay a simple indexed comparison. Maintained by review.service.
  ratingAvg      Int           @default(0)
  totalSold      Int           @default(0)

  // Flexible attributes / specifications / shipping info (category-agnostic)
  attributes     Json?
  specifications Json?
  shippingInfo   Json?

  // SEO
  metaTitle      String?
  metaDescription String?

  publishedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sku, sellerId])
  @@index([status, publishedAt])
  @@index([sellerId, status])
  @@index([shopId, status])
  @@index([categoryId, status])
  @@index([brandId])
  @@index([price])
  @@index([effectivePrice])
  @@index([ratingAvg])
  @@index([totalSold])
}

model ProductVariant {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  name      String
  sku       String
  price     Int?
  // JSON of attribute key/values: { "color": "Navy", "size": "M" }
  options   Json
  isActive  Boolean @default(true)

  cartItems CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([sku])
}

model ProductImage {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  url       String
  alt       String  @default("")
  position  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, position])
}

model Inventory {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  productId    String  @unique @db.ObjectId
  product      Product @relation(fields: [productId], references: [id])

  quantity           Int    @default(0)
  reserved           Int    @default(0)
  lowStockThreshold  Int    @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quantity])
}

// -----------------------------------------------------------------------------
// Customer — cart, wishlist, addresses
// -----------------------------------------------------------------------------

model Address {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  userId      String      @db.ObjectId
  user        User        @relation(fields: [userId], references: [id])

  type        AddressType @default(HOME)
  label       String?
  line1       String
  line2       String?
  city        String
  region      String
  postalCode  String
  country     String      @default("PK")
  phone       String?
  isDefault   Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isDefault])
}

model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @unique @db.ObjectId
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  cartId    String          @db.ObjectId
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  productId String          @db.ObjectId
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?         @db.ObjectId
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  quantity  Int             @default(1)

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([cartId])
  @@index([productId])
}

model Wishlist {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

// -----------------------------------------------------------------------------
// Orders — parent marketplace order split into per-seller orders
// -----------------------------------------------------------------------------

model Order {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber     String       @unique

  userId          String       @db.ObjectId
  customer        User         @relation(fields: [userId], references: [id])

  status          OrderStatus  @default(PENDING)

  // Money — integer minor units
  subtotal        Int
  shippingTotal   Int          @default(0)
  discountTotal   Int          @default(0)
  taxTotal        Int          @default(0)
  total           Int

  // Address snapshot at time of order (immutable)
  shippingAddress Json
  billingAddress  Json?

  couponCode      String?
  note            String?

  placedAt        DateTime     @default(now())
  confirmedAt     DateTime?
  deliveredAt     DateTime?

  items           OrderItem[]
  sellerOrders    SellerOrder[]
  payments        Payment[]
  returnRequests  ReturnRequest[]
  refunds         Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, placedAt])
  @@index([status])
  @@index([placedAt])
}

model OrderItem {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String  @db.ObjectId
  order      Order   @relation(fields: [orderId], references: [id])

  productId  String  @db.ObjectId
  variantId  String? @db.ObjectId

  // Denormalized snapshots (survive product edits/deletion)
  sellerId   String  @db.ObjectId
  shopId     String  @db.ObjectId
  title      String
  sku        String
  imageUrl   String?
  variantLabel String?

  quantity   Int
  unitPrice  Int
  // lineTotal = quantity * unitPrice (stored for auditability)
  lineTotal  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([sellerId])
  @@index([productId])
}

model SellerOrder {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId

  // The parent marketplace order this belongs to
  orderId         String      @db.ObjectId
  order           Order       @relation(fields: [orderId], references: [id])

  sellerId        String      @db.ObjectId
  seller          SellerProfile @relation(fields: [sellerId], references: [id])
  shopId          String      @db.ObjectId
  shop            Shop        @relation(fields: [shopId], references: [id])

  orderNumber     String      @unique
  status          OrderStatus @default(PENDING)

  // Money — integer minor units
  subtotal        Int
  shippingTotal   Int         @default(0)
  commissionTotal Int         @default(0)
  earningTotal    Int

  commissionBps   Int

  shipment        Json?

  items           SellerOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId, status])
  @@index([shopId, status])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model SellerOrderItem {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  sellerOrderId String       @db.ObjectId
  sellerOrder   SellerOrder  @relation(fields: [sellerOrderId], references: [id])

  orderItemId   String       @db.ObjectId
  productId     String       @db.ObjectId
  variantId     String?      @db.ObjectId

  title         String
  sku           String
  quantity      Int
  unitPrice     Int
  lineTotal     Int
  commission    Int
  earning       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerOrderId])
  @@index([orderItemId])
}

model Payment {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId     String        @db.ObjectId
  order       Order         @relation(fields: [orderId], references: [id])

  method      PaymentMethod
  provider    String
  providerRef String?
  amount      Int
  currency    String        @default("PKR")
  status      PaymentStatus @default(PENDING)

  // Sanitized provider payload. NEVER store raw card data (PAN/CVV).
  rawPayload  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([providerRef])
}

// -----------------------------------------------------------------------------
// Finance — commissions, earnings, payouts
// -----------------------------------------------------------------------------

model Commission {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  scope       CommissionScope
  // Target id when scope is CATEGORY / SELLER / PRODUCT; null for GLOBAL
  targetId    String?        @db.ObjectId
  // Commission in basis points (1000 = 10.00%)
  rateBps     Int
  isActive    Boolean        @default(true)
  effectiveFrom DateTime     @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, targetId, isActive])
}

model Payout {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  sellerId      String       @db.ObjectId
  seller        SellerProfile @relation(fields: [sellerId], references: [id])

  amount        Int
  status        PayoutStatus @default(REQUESTED)
  method        String?
  reference     String?
  notes         String?

  requestedAt   DateTime     @default(now())
  processedAt   DateTime?
  processedById String?      @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId, status])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Reviews, coupons, returns
// -----------------------------------------------------------------------------

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])

  productId String?  @db.ObjectId
  product   Product? @relation(fields: [productId], references: [id])

  shopId    String?  @db.ObjectId
  shop      Shop?    @relation(fields: [shopId], references: [id])

  rating    Int
  title     String?
  comment   String?
  isApproved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId, isApproved])
  @@index([shopId, isApproved])
  @@index([rating])
}

model Coupon {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  code      String     @unique
  type      CouponType
  // PERCENT → basis points (1000 = 10%). FIXED → amount in minor units.
  value     Int
  minOrder  Int?
  maxUses   Int?
  usedCount Int        @default(0)
  startsAt  DateTime?
  expiresAt DateTime?
  isActive  Boolean    @default(true)

  usages    CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, expiresAt])
}

model CouponUsage {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  couponId String  @db.ObjectId
  coupon   Coupon  @relation(fields: [couponId], references: [id])
  userId   String  @db.ObjectId
  orderId  String? @db.ObjectId
  amount   Int

  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}

model ReturnRequest {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  orderId     String       @db.ObjectId
  order       Order        @relation(fields: [orderId], references: [id])
  orderItemId String       @db.ObjectId
  sellerOrderId String?    @db.ObjectId

  reason      String
  note        String?
  status      ReturnStatus @default(REQUESTED)
  imageUrl    String?

  reviewedAt  DateTime?
  reviewedById String?     @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([orderId])
}

model Refund {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId         String        @db.ObjectId
  order           Order         @relation(fields: [orderId], references: [id])
  returnRequestId String?       @db.ObjectId

  amount          Int
  status          RefundStatus  @default(PENDING)
  providerRef     String?
  note            String?

  processedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Platform content & settings
// -----------------------------------------------------------------------------

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  user      User             @relation(fields: [userId], references: [id])

  type      NotificationType
  title     String
  body      String?
  link      String?
  isRead    Boolean          @default(false)

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, isRead, createdAt])
}

model Banner {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  subtitle  String?
  imageUrl  String
  link      String?
  position  Int          @default(0)
  status    BannerStatus @default(ACTIVE)
  startsAt  DateTime?
  endsAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, position])
}

model PlatformSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       Json
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
